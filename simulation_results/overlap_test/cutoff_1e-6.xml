<?xml version="1.0"?>

<!--
    PAPER-CONFIG GROWTH RUN (Fig. 1e / Table 2, Runser et al. 2024)

    PURPOSE: Exponential growth from a single cell, matching the paper's
    125k-cell benchmark configuration (Nature Comp. Sci. 4, 299-309).

    PARAMETERS MATCHING PAPER TABLE 2 (dynamic column):
    - Time step:            1e-7 s
    - Damping:              2.5e-10 kg/s
    - Bulk modulus K:       2500 Pa       - Max pressure p_max: 2500 Pa
    - Mass density:         1000 kg/m^3   - Area elasticity k_a: 1e-15 J
    - Surface tension:      1e-3 N/m (lateral 8e-4, upstream v1.0 default)
    - Bending stiffness:    2e-18 J (re-enabled; was 0 in fast-growth config)
    - Adhesion/repulsion:   1e9 Pa/m      - Q_0: 250
    - Contact cutoff c:     2e-7 m        - H_max: 5e6 1/m
    - Division vol V_max:   1.4e-15 m^3 (paper cell size, ~14 um diameter)
    - Min vol V_min:        3.7e-16 m^3
    - Growth rate g:        1e-11 m^3/s -> cell cycle = 7e-5 s ("pushed to
                            the limit": 125k cells in ~1.2e-3 s sim time)

    DOCUMENTED DEVIATION FROM TABLE 2:
    - min_edge_length 1e-6 m (not Table 2's 2e-7). The paper's own 125k run
      used coarse cells: "121 nodes and 238 triangular faces on average"
      (p.301). At V_max=1.4e-15, l_min=1e-6 reproduces that (~240-480
      tri/cell); Table 2's 2e-7 would give ~10,000 tri/cell and contradicts
      the paper's reported mesh statistics for this benchmark.

    STARTING MESH: paper_sphere.vtk - single cell, V=1.0e-15 m^3 (mid-cycle,
    between V_min and V_max), re-triangulated at l_min on startup (paper's
    initialization procedure, Supplementary Fig. 1).

    TIMESCALE (all sim-time values are milliseconds now, NOT seconds):
    - 1 cell cycle = 7e-5 s = 700 iterations
    - 20k cells  ~ 1.0e-3 s sim time (~10k iterations)
    - 125k cells ~ 1.2e-3 s sim time (~12k iterations)
    - sampling_period 1e-4 -> VTK snapshot every 1000 iterations
      (previous value 1.0 s never fired on a realistic run)

    COMPILATION REQUIREMENTS (global_configuration.hpp):
        POLARIZATION_MODE_INDEX:    1  (contact-based polarization)
        CONTACT_MODEL_INDEX:        2  (face-face coupling)
        DYNAMIC_MODEL_INDEX:        0  (semi-implicit Euler, paper Figs 1,3,4)

    FALLBACKS IF UNSTABLE (revert in this order):
    - enable_edge_swap_operation back to 0
    - contact cutoffs back to 5e-7 (mesh-scaled)
-->

<numerical_parameters>
    <!-- Single paper-sized cell (V=1.0e-15 m^3) for exponential growth -->
    <input_mesh_file_path>data/input_meshes/paper_sphere.vtk</input_mesh_file_path>

    <!-- Output path (can be overridden via command line) -->
    <output_mesh_folder_path>/home/nilesh-patil/projects/simucell3d/simulation_results/longrun_20k_fast_growth</output_mesh_folder_path>

    <!-- Re-triangulate the input at l_min (paper's Poisson-disc init, Supp. Fig. 1) -->
    <perform_initial_triangulation>1</perform_initial_triangulation>

    <!-- Edge swaps are part of the paper's mesh maintenance (Supp. Fig. 2c) -->
    <enable_edge_swap_operation>1</enable_edge_swap_operation>

    <!-- Damping coefficient [kg/s] - Table 2 (dynamic): 2.5e-10 -->
    <damping_coefficient>2.5e-10</damping_coefficient>

    <!-- Simulation duration [s] - ~28 cell cycles; wall-clock cap governs in practice -->
    <simulation_duration>9.05e-4</simulation_duration>

    <!-- VTK snapshot every 1e-4 s of sim time = every 1000 iterations -->
    <sampling_period>1e-4</sampling_period>

    <!-- Time step [s] - Table 2: 1e-7 s -->
    <time_step>1e-7</time_step>

    <!-- Mesh resolution [m] - reproduces paper's 121 nodes / 238 faces per cell
         at paper cell size (see header for why NOT Table 2's 2e-7) -->
    <min_edge_length>1e-6</min_edge_length>

    <!-- Contact cutoffs [m] - Table 2: c = 2e-7 -->
    <contact_cutoff_adhesion>1e-6</contact_cutoff_adhesion>
    <contact_cutoff_repulsion>1e-6</contact_cutoff_repulsion>
</numerical_parameters>

<cell_types>
    <cell_type>
        <cell_type_name>epithelial</cell_type_name>
        <global_cell_id>0</global_cell_id>

        <!-- Cell density [kg/m^3] - Table 2: rho = 1000 -->
        <cell_mass_density>1.0e3</cell_mass_density>

        <!-- Bulk modulus [Pa] - Table 2: K = 2500 -->
        <cell_bulk_modulus>2.5e3</cell_bulk_modulus>

        <!-- Max inner pressure [Pa] - Table 2: p_max = 2500 -->
        <max_inner_pressure>2.5e3</max_inner_pressure>

        <!-- Growth rate [m^3/s] - Table 2: g = 1e-11 (10% std as before) -->
        <avg_growth_rate>1e-11</avg_growth_rate>
        <std_growth_rate>1e-12</std_growth_rate>

        <!-- Target isoperimetric ratio - Table 2: Q_0 = 250 -->
        <target_isoperimetric_ratio>250</target_isoperimetric_ratio>

        <!-- Area elasticity [J] - Table 2: k_a = 1e-15 -->
        <area_elasticity_modulus>1e-15</area_elasticity_modulus>

        <!-- Angle regularization -->
        <angle_regularization_factor>0</angle_regularization_factor>

        <!-- Division volume [m^3] - Table 2: V_max = 1.4e-15 (~14 um cells) -->
        <avg_division_volume>1.4e-15</avg_division_volume>
        <std_division_volume>1.4e-16</std_division_volume>

        <!-- Curvature cutoff for surface coupling [1/m] - Table 2: H_max = 5e6 -->
        <surface_coupling_max_curvature>5e6</surface_coupling_max_curvature>

        <!-- Min cell volume before removal [m^3] - Table 2: V_min = 3.7e-16 -->
        <min_vol>3.7e-16</min_vol>

        <!-- Face types: apical, lateral, basal (epithelial polarization).
             Tensions follow upstream v1.0 defaults (Table 2 lists gamma=1e-3);
             bending re-enabled at Table 2's k_b = 2e-18 J on all faces. -->
        <face_types>
            <face_type>
                <global_face_id>0</global_face_id>
                <face_type_name>apical</face_type_name>
                <adherence_strength>1e9</adherence_strength>
                <repulsion_strength>1e9</repulsion_strength>
                <surface_tension>1e-3</surface_tension>
                <bending_modulus>2e-18</bending_modulus>
            </face_type>

            <face_type>
                <global_face_id>1</global_face_id>
                <face_type_name>lateral</face_type_name>
                <adherence_strength>1e9</adherence_strength>
                <repulsion_strength>1e9</repulsion_strength>
                <surface_tension>8e-4</surface_tension>
                <bending_modulus>2e-18</bending_modulus>
            </face_type>

            <face_type>
                <global_face_id>2</global_face_id>
                <face_type_name>basal</face_type_name>
                <adherence_strength>0</adherence_strength>
                <repulsion_strength>5e8</repulsion_strength>
                <surface_tension>1e-3</surface_tension>
                <bending_modulus>2e-18</bending_modulus>
            </face_type>
        </face_types>
    </cell_type>
</cell_types>
